{
  "name": "njucli",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "南京大学校园服务 CLI 与 AI Skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcWebber/njucli.git"
  },
  "homepage": "https://github.com/MarcWebber/njucli#readme",
  "bugs": "https://github.com/MarcWebber/njucli/issues",
  "type": "module",
  "bin": {
    "njucli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "AGENTS.md",
    ".codex-plugin",
    ".mcp.json",
    "skills",
    "scripts",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/build-skills.mjs",
    "postinstall": "node scripts/install-skills.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "playwright-core": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.27.0"
}
