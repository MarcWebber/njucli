{
  "name": "njucli",
  "version": "0.1.0",
  "description": "面向南京大学学生与 AI 的校园服务命令行。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcWebber/njucli.git"
  },
  "homepage": "https://github.com/MarcWebber/njucli#readme",
  "bugs": "https://github.com/MarcWebber/njucli/issues",
  "type": "module",
  "bin": {
    "njucli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    ".codex-plugin",
    ".mcp.json",
    "skills",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/integration.test.mjs",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@inquirer/input": "^4.3.0",
    "@inquirer/password": "^4.0.23",
    "@napi-rs/keyring": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "playwright-core": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.27.0"
}
